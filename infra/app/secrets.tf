# Secrets are generated by ephemeral resources: Terraform creates the value during the run, writes
# it into RDS and SSM through write-only attributes, and never stores it in the state file. The
# application reads them from SSM at task start. Bump var.secrets_version to replace all of them.
#
# SSM Parameter Store (SecureString, encrypted with the AWS-managed key) instead of RDS's built-in
# Secrets Manager integration: the spec asks for SSM, standard parameters are free, and Secrets
# Manager would rotate the RDS password every 7 days while running tasks keep the old one.

ephemeral "random_password" "db_owner" {
  length  = 32
  special = false
}

ephemeral "random_password" "db_app" {
  length  = 32
  special = false
}

ephemeral "random_password" "registration_code" {
  length  = 24
  special = false
}

resource "aws_ssm_parameter" "db_owner_password" {
  name             = "/${local.name}/db/owner-password"
  description      = "Password of the RDS master user; used only by Flyway migrations"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.db_owner.result
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "db_app_password" {
  name             = "/${local.name}/db/app-password"
  description      = "Password of the least-privilege role splitledger_app the API connects with"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.db_app.result
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "registration_code" {
  name             = "/${local.name}/registration-code"
  description      = "Code needed to register on the public demo (X-Registration-Code header)"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.registration_code.result
  value_wo_version = var.secrets_version
}
