# Copy to .env (git-ignored) on the host and replace every value.
# A domain whose DNS points to this machine, e.g. a free DuckDNS name: splitledger-wg.duckdns.org
DOMAIN=splitledger.example.org
# Owner of the tables (Flyway) and the least-privilege role the API uses; long random strings.
DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
# Friends need this code to register (X-Registration-Code header).
REGISTRATION_CODE=change-me-as-well
