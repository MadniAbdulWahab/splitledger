# Copy to .env (git-ignored) and choose your own passwords.
# Owner of the tables; Flyway migrates with it.
DB_PASSWORD=change-me
# Least-privilege role the application runs as; set automatically on every start.
APP_DB_PASSWORD=change-me-too
# Host port for PostgreSQL; change it if 5432 is already used by another project.
DB_PORT=5432
